{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorResponse",
  "type": "object",
  "required": ["detail"],
  "properties": {
    "detail": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["loc", "msg"],
            "properties": {
              "type": { "type": "string" },
              "loc": { "type": "array" },
              "msg": { "type": "string" },
              "input": {},
              "url": { "type": "string" }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
